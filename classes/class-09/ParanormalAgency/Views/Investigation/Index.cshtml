@model IEnumerable<Investigation>
@{ ViewData["Title"] = "Investigaciones"; }
@* Muestra los datos de cada investigación y sus acciones. *@
<h2>Lista de investigaciones</h2>
<p><a asp-action="Create" class="btn btn-primary">Agregar investigación</a></p>
<div class="table-responsive">
<table class="table table-striped">
    <thead><tr><th>Caso</th><th>Cliente</th><th>Fenómeno</th><th>Riesgo</th><th>Presupuesto (USD)</th><th>Equipo</th><th>Fecha</th><th>Costo total (USD)</th><th>Acciones</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CaseName</td><td>@item.ClientName</td><td>@item.PhenomenonType</td><td>@item.RiskLevel</td>
            <td>@item.BaseBudget?.ToString("N2")</td><td>@(item.RequiresSpecializedEquipment == true ? "Sí" : "No")</td>
            <td>@item.InvestigationDate?.ToString("dd/MM/yyyy")</td><td>@item.TotalCost.ToString("N2")</td>
            <td><a asp-action="Edit" asp-route-id="@item.Id">Actualizar</a> | <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a></td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (!Model.Any()) { <p>No hay investigaciones registradas.</p> }