@model Zara.Models.Prenda
@{ ViewData["Title"] = "Agregar prenda"; }

@* GET /Prenda/Create muestra el formulario vacío. Al pulsar Guardar,
   el POST /Prenda/Create recibe Prenda prendita, valida ModelState
   y solo guarda cuando los datos son válidos. *@
<h2>Agregar prenda</h2>
<form asp-controller="Prenda" asp-action="Create" method="post">
    @* Muestra errores de validación y errores al guardar devueltos por el Controller. *@
    <div asp-validation-summary="All" class="text-danger"></div>

    @* Marca: solo letras; talla y género: opciones cerradas; precio: número positivo. *@
    <div class="mb-3">
        <label asp-for="Marca" class="form-label"></label>
        <input asp-for="Marca" class="form-control" maxlength="25" pattern="[A-Za-zÁÉÍÓÚÜÑáéíóúüñ ]+" title="Solo letras y espacios" required />
        <span asp-validation-for="Marca" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Talla" class="form-label"></label>
        <select asp-for="Talla" class="form-select" required>
            <option value="">Seleccione una talla</option>
            @* Valores permitidos por la validación del modelo Prenda. *@
            @foreach (var talla in new[] { "XS", "S", "M", "L", "XL", "XXL" })
            {
                <option value="@talla">@talla</option>
            }
        </select>
        <span asp-validation-for="Talla" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" type="number" step="0.01" min="0.01" max="999999999.99" class="form-control" required />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Genero" class="form-label"></label>
        <select asp-for="Genero" class="form-select" required>
            <option value="">Seleccione una categoría</option>
            @* Categorías de ropa definidas para este ejercicio. *@
            <option value="Hombre">Hombre</option>
            <option value="Mujer">Mujer</option>
            <option value="Unisex">Unisex</option>
        </select>
        <span asp-validation-for="Genero" class="text-danger"></span>
    </div>

    @* Submit envía los datos mediante POST; el controlador redirige al Index
       si guarda correctamente y vuelve a mostrar esta vista si hay errores. *@
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@* Scripts para validar los campos en el navegador. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
