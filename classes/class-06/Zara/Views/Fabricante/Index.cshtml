@model IEnumerable<Zara.Models.Fabricante>
@{ ViewData["Title"] = "Fabricantes"; }

@* GET Index: lista los registros recuperados mediante Service.mostrarFabricantes. *@
<h2>Fabricantes</h2>
<p><a asp-action="Create" class="btn btn-primary">Agregar fabricante</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Prestigio</th>
            <th>Fecha de creación</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @* Fecha renderizada como texto sin hora; un registro por fila. *@
        @foreach (var fabricante in Model)
        {
            <tr>
                <td>@fabricante.Id</td>
                <td>@fabricante.Prestigio</td>
                <td>@(fabricante.FechaCreacion?.ToString("dd/MM/yyyy"))</td>
                <td>
                    <a asp-action="Details" asp-route-id="@fabricante.Id">Detalles</a> |
                    <a asp-action="Edit" asp-route-id="@fabricante.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@fabricante.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
