@model Zara.Models.Fabricante
@{ ViewData["Title"] = "Editar fabricante"; }

@* GET Edit precarga el registro. POST Edit valida y modifica sus dos campos. *@
<h2>Editar fabricante</h2>
<form asp-controller="Fabricante" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @* El ID existe para ubicar el registro, pero no es editable. *@
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Prestigio" class="form-label"></label>
        @* asp-for selecciona automáticamente el valor actual entre estas opciones. *@
        <select asp-for="Prestigio" class="form-select" required>
            <option value="">Seleccione un prestigio</option>
            <option value="Bajo">Bajo</option>
            <option value="Medio">Medio</option>
            <option value="Alto">Alto</option>
        </select>
        <span asp-validation-for="Prestigio" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaCreacion" class="form-label"></label>
        @* Date picker sin horas; asp-format conserva el formato yyyy-MM-dd. *@
        <input asp-for="FechaCreacion" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required />
        <span asp-validation-for="FechaCreacion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
