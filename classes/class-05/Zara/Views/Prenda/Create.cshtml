@model Zara.Models.Prenda
@{ ViewData["Title"] = "Agregar prenda"; }

@* GET /Prenda/Create muestra el formulario vacío. Al pulsar Guardar,
   el POST /Prenda/Create recibe Prenda prendita, valida ModelState
   y solo guarda cuando los datos son válidos. *@
<h2>Agregar prenda</h2>
<form asp-controller="Prenda" asp-action="Create" method="post">
    @* Muestra errores de validación y errores al guardar devueltos por el Controller. *@
    <div asp-validation-summary="All" class="text-danger"></div>

    @* Campos del modelo que se envían al controlador. *@
    <div class="mb-3">
        <label asp-for="Marca" class="form-label"></label>
        <input asp-for="Marca" class="form-control" maxlength="25" />
        <span asp-validation-for="Marca" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Talla" class="form-label"></label>
        <input asp-for="Talla" class="form-control" />
        <span asp-validation-for="Talla" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Genero" class="form-label"></label>
        <input asp-for="Genero" class="form-control" />
        <span asp-validation-for="Genero" class="text-danger"></span>
    </div>

    @* Submit envía los datos mediante POST; el controlador redirige al Index
       si guarda correctamente y vuelve a mostrar esta vista si hay errores. *@
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@* Scripts para validar los campos en el navegador. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
