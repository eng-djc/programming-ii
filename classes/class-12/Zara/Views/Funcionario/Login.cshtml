@model LoginFuncionario
@{
    ViewData["Title"] = "Login funcionario";
}

<script>
    // document representa la página HTML que Razor construye con el layout y esta vista.
    // El navegador ya leyó el div del menú porque aparece antes de RenderBody en el layout.
    // getElementById busca ese elemento por su id y guarda la referencia en la variable menu.
    var menu = document.getElementById("menu");

    // display = "none" oculta el menú y libera su espacio solo en la página de login.
    menu.style.display = "none";
</script>

<h1>Login funcionario</h1>
<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Usuario"></label>
        <input asp-for="Usuario" class="form-control" autocomplete="username" maxlength="100" required />
        <span asp-validation-for="Usuario" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Clave"></label>
        <input asp-for="Clave" type="password" class="form-control" autocomplete="current-password" required />
        <span asp-validation-for="Clave" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Aceptar</button>
    <button type="submit" form="cancelar-login" class="btn btn-secondary">Cancelar</button>
</form>
<form id="cancelar-login" action="@Url.Action("Login", "Funcionario")" method="get"></form>

@* Si el servicio rechaza las credenciales, el POST de FuncionarioController captura
   AuthenticationException, asigna ex.Message a ViewBag.Error y devuelve esta vista.
   ViewBag comparte ese mensaje con la vista durante la solicitud actual. Al abrir
   el login o pulsar Cancelar se hace un nuevo GET y ViewBag.Error queda sin valor. *@
@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    @* El signo ! invierte la condición: solo se genera el encabezado si hay texto. *@
    <h3 style="color: red" role="alert">@ViewBag.Error</h3>
}
