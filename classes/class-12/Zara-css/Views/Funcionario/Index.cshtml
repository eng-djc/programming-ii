@model IEnumerable<Funcionario>
@{
    ViewData["Title"] = "Funcionarios";
}

<div class="funcionarios">
    <h2>Lista de funcionarios</h2>
    <p><a asp-action="Create" class="btn btn-primary">Agregar funcionario</a></p>

    <div class="tabla-desplazable" role="region" aria-label="Lista de funcionarios" tabindex="0">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Cédula</th>
                    <th>Teléfono</th>
                    <th>Fecha de nacimiento</th>
                    <th>Estado</th>
                    <th>Perfil</th>
                    <th>Usuario</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var funcionario in Model)
                {
                    <tr>
                        <td data-label="Nombre">@funcionario.Nombre</td>
                        <td data-label="Cédula">@funcionario.Cedula</td>
                        <td data-label="Teléfono">@funcionario.Telefono</td>
                        <td data-label="Fecha de nacimiento">@funcionario.FechaNacimiento?.ToString("dd/MM/yyyy")</td>
                        <td data-label="Estado">@(funcionario.Activo == true ? "Activo" : "Inactivo")</td>
                        <td data-label="Perfil">@funcionario.Perfil</td>
                        <td data-label="Usuario">@funcionario.Usuario</td>
                        <td data-label="Acciones">
                            <a asp-action="Details" asp-route-id="@funcionario.Id">Detalles</a> |
                            <a asp-action="Edit" asp-route-id="@funcionario.Id">Actualizar</a> |
                            <a asp-action="Delete" asp-route-id="@funcionario.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
