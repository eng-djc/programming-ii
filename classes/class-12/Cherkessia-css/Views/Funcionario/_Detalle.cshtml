@model Funcionario
<dl class="row">
    <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Cédula</dt><dd class="col-sm-9">@Model.Cedula</dd>
    <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@Model.Telefono</dd>
    <dt class="col-sm-3">Fecha de nacimiento</dt><dd class="col-sm-9">@Model.FechaNacimiento?.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@(Model.Activo == true ? "Activo" : "Inactivo")</dd>
    <dt class="col-sm-3">Perfil</dt><dd class="col-sm-9">@Model.Perfil</dd>
    <dt class="col-sm-3">Usuario</dt><dd class="col-sm-9">@Model.Usuario</dd>
</dl>
