@model Funcionario
<div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" type="text" class="form-control" maxlength="100" required />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Cedula" class="form-label"></label>
    <input asp-for="Cedula" type="number" min="1" max="9223372036854775807" step="1" class="form-control" required />
    <span asp-validation-for="Cedula" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Telefono" class="form-label"></label>
    <input asp-for="Telefono" type="tel" class="form-control" maxlength="30" required />
    <span asp-validation-for="Telefono" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="FechaNacimiento" class="form-label"></label>
    <input asp-for="FechaNacimiento" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required />
    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
</div>
<fieldset class="mb-3">
    <legend class="fs-6">Estado</legend>
    <div class="form-check"><input asp-for="Activo" type="radio" value="true" id="estado-activo" class="form-check-input" required /><label for="estado-activo">Activo</label></div>
    <div class="form-check"><input asp-for="Activo" type="radio" value="false" id="estado-inactivo" class="form-check-input" required /><label for="estado-inactivo">Inactivo</label></div>
    <span asp-validation-for="Activo" class="text-danger"></span>
</fieldset>
<div class="mb-3">
    <label asp-for="Perfil" class="form-label"></label>
    <select asp-for="Perfil" class="form-select" required>
        <option value="">Seleccione un perfil</option>
        @foreach (var perfil in Funcionario.Perfiles) { <option value="@perfil">@perfil</option> }
    </select>
    <span asp-validation-for="Perfil" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Usuario" class="form-label"></label>
    <input asp-for="Usuario" type="text" class="form-control" maxlength="100" required />
    <span asp-validation-for="Usuario" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Clave" class="form-label"></label>
    @if (ViewData["Editando"] as bool? == true)
    {
        <input asp-for="Clave" type="password" class="form-control" />
        <small>Deje la clave vacía para conservar la actual.</small>
    }
    else
    {
        <input asp-for="Clave" type="password" class="form-control" required />
    }
    <span asp-validation-for="Clave" class="text-danger"></span>
</div>
