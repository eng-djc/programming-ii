@model Instrumento
@{ ViewData["Title"] = "Editar instrumento"; }
<h2>Editar instrumento</h2>
<form asp-controller="Instrumento" asp-action="Edit" asp-route-id="@Model.Codigo" method="post">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><p>Código: @Model.Codigo</p><input asp-for="Codigo" type="hidden" /></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="100" required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaRegistro" class="form-label"></label>
        <input asp-for="FechaRegistro" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required />
        <span asp-validation-for="FechaRegistro" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" required />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Garantia" class="form-label"></label>
        <select asp-for="Garantia" class="form-select" required>
            <option value="">Seleccione la garantía</option>
            @for (int anios = 1; anios <= 5; anios++)
            {
                <option value="@anios">@anios</option>
            }
        </select>
        <span asp-validation-for="Garantia" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
