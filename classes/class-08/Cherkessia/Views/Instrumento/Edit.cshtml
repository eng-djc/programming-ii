@model Instrumento
@{ ViewData["Title"] = "Editar instrumento"; }
<h1>Editar instrumento</h1>
<div class="row"><div class="col-md-4">
    <form asp-action="Edit" asp-route-id="@Model.Codigo" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group mb-3"><p>Código: @Model.Codigo</p><input asp-for="Codigo" type="hidden" /></div>
        <partial name="_Campos" model="Model" />
        <button type="submit" class="btn btn-primary">Actualizar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div></div>
