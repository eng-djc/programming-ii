@model Instrumento
<div class="form-group mb-3">
    <label asp-for="Nombre" class="control-label"></label>
    <input asp-for="Nombre" class="form-control" maxlength="100" required />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="form-group mb-3">
    <label asp-for="FechaRegistro" class="control-label"></label>
    <input asp-for="FechaRegistro" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required />
    <span asp-validation-for="FechaRegistro" class="text-danger"></span>
</div>
<div class="form-group mb-3">
    <label asp-for="Precio" class="control-label"></label>
    <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" required />
    <span asp-validation-for="Precio" class="text-danger"></span>
</div>
<div class="form-group mb-3">
    <label asp-for="Garantia" class="control-label"></label>
    <select asp-for="Garantia" class="form-select" required>
        <option value="">Seleccione la garantía</option>
        @for (int anios = 1; anios <= 5; anios++)
        {
            <option value="@anios">@anios</option>
        }
    </select>
    <span asp-validation-for="Garantia" class="text-danger"></span>
</div>
