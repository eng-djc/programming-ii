<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cherkessia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cherkessia.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid flex-wrap">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Cherkessia</a>
                @* Menú siempre visible: no necesita JavaScript para expandirse. *@
                <ul class="navbar-nav flex-row flex-wrap gap-3">
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Instrumento" asp-action="Index">Instrumentos</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Volcan" asp-action="Index">Volcanes</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container"><main role="main" class="pb-3">@RenderBody()</main></div>
    <footer class="border-top footer text-muted">
        <div class="container">&copy; 2026 - Cherkessia - <a asp-controller="Home" asp-action="Privacy">Privacy</a></div>
    </footer>
</body>
</html>
