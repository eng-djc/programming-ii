@model Volcan
@{ ViewData["Title"] = "Editar volcán"; }
<h2>Editar volcán</h2>
<form asp-controller="Volcan" asp-action="Edit" asp-route-nombre="@Model.Nombre" method="post">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><p>Nombre: @Model.Nombre</p><input asp-for="Nombre" type="hidden" /></div>
    <partial name="_Campos" model="Model" />
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
