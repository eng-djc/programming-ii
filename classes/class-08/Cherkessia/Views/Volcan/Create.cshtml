@model Volcan
@{ ViewData["Title"] = "Agregar volcán"; }
<h2>Agregar volcán</h2>
<form asp-controller="Volcan" asp-action="Create" method="post">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="100" required />
        <span asp-validation-for="Nombre" class="text-danger"></span></div>
    <partial name="_Campos" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
