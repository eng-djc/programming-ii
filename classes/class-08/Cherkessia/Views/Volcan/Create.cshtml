@model Volcan
@{ ViewData["Title"] = "Agregar volcán"; }
<h1>Agregar volcán</h1>
<div class="row"><div class="col-md-4">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group mb-3"><label asp-for="Nombre" class="control-label"></label>
            <input asp-for="Nombre" class="form-control" maxlength="100" required />
            <span asp-validation-for="Nombre" class="text-danger"></span></div>
        <partial name="_Campos" model="Model" />
        <p>El IRV se calcula al guardar con los datos del instrumento seleccionado.</p>
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div></div>
