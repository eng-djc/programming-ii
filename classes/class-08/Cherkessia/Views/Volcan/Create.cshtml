@model Volcan
@{ ViewData["Title"] = "Agregar volcán"; }
<h2>Agregar volcán</h2>
<form asp-controller="Volcan" asp-action="Create" method="post">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="100" required />
        <span asp-validation-for="Nombre" class="text-danger"></span></div>
    <div class="mb-3">
        <label asp-for="Provincia" class="form-label"></label>
        <select asp-for="Provincia" class="form-select" required>
            <option value="">Seleccione una provincia</option>
            @foreach (var provincia in Volcan.Provincias) { <option value="@provincia">@provincia</option> }
        </select>
        <span asp-validation-for="Provincia" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Activo" class="form-label"></label>
        <select asp-for="Activo" class="form-select" required>
            <option value="">Seleccione una opción</option><option value="true">Sí</option><option value="false">No</option>
        </select>
        <span asp-validation-for="Activo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Gases" class="form-label"></label>
        <select asp-for="Gases" class="form-select" required>
            <option value="">Seleccione una opción</option>
            @foreach (var gases in Volcan.OpcionesGases) { <option value="@gases">@gases</option> }
        </select>
        <span asp-validation-for="Gases" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="InstrumentoCodigo" class="form-label"></label>
        <select asp-for="InstrumentoCodigo" asp-items="ViewBag.Instrumentos" class="form-select" required>
            <option value="">Seleccione un instrumento</option>
        </select>
        <span asp-validation-for="InstrumentoCodigo" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
