@model IEnumerable<ProyectoWeb.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>

@if (TempData["MensajeUsuario"] is string mensaje)
{
    <p role="status">@mensaje</p>
}

<p>
    <a asp-controller="Usuario" asp-action="Create">Agregar usuario</a>
</p>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Edad)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FechaNacimiento)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Perfil)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PermisosExtras)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Otros)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.User)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Edad)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FechaNacimiento)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Perfil)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PermisosExtras)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Otros)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.User)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
